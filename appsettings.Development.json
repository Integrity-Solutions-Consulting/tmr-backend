{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "tmr-backend",
    "Audience": "tmr-frontend",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "IdleTimeoutDays": 2,
    "AbsoluteTimeoutDays": 7,
    "MaxActiveSessions": 3
  },
  "DetailedErrors": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Information",
        "System": "Information",
        "Npgsql": "Information",
        "Quartz": "Information"
      }
    }
  }
}
