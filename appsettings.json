{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "tmr-backend",
    "Audience": "tmr-frontend",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "IdleTimeoutDays": 2,
    "AbsoluteTimeoutDays": 7,
    "MaxActiveSessions": 3
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Nivel:l}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "ISC Time Report",
    "SenderEmail": "",
    "Username": "",
    "Password": "",
    "OverrideEmailRecipient": "",
    "FrontendUrl": "http://localhost:3000"
  },
  "WeeklyNotificationSettings": {
    "Enabled": false,
    "DayOfWeek": "Friday",
    "Hour": 17,
    "Minute": 0,
    "CheckIntervalMinutes": 5
  },
  "Apprise": {
    "Enabled": false,
    "ApiUrl": "",
    "Tag": "notificaciones",
    "UrlTemplates": [],
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30,
    "LogoUrl": ""
  },
  "NotificacionHoras": {
    "Habilitado": false,
    "InicioPeriodo": "2026-10-01",
    "FinPeriodo": "2026-10-15",
    "FechaCorte": "2026-10-15T18:00:00-05:00",
    "UmbralNotificacionManual": 24
  }
}
