# Copia este archivo como .env y completa valores solo en tu equipo.
# .env está ignorado por Git y nunca debe contenerse en un commit.
JWT_SECRET_KEY=
# Compose inyecta este valor como ConnectionStrings__DefaultConnection.
DB_CONNECTION_STRING=
# Compose inyecta este valor como IntegracionRps__ApiKey. Debe ser igual a Tmr__ApiKey en rps-backend.
RPS_API_KEY=
# Referencia para --initialize-data: exportar estas variables en el proceso
# y pasarlas con compose run -e (Compose no las inyecta desde .env por sí solo).
# Proporcionar las cuatro juntas; nunca se reemplaza una cuenta existente.
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=
Bootstrap__AdminIdentification=
Bootstrap__AdminName=
